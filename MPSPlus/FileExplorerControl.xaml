<DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:vs="http://schemas.microsoft.com/visualstudio/extensibility/2022/xaml"
              xmlns:styles="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0">
    <!-- 根布局与控件背景统一用 VsBrushes.WindowKey：跟随 VS 主题（Dark 下为深色），文本用 WindowTextKey（Dark 下为白色） -->
    <Grid x:Name="RootGrid" Background="{DynamicResource {x:Static styles:VsBrushes.WindowKey}}">
        <Grid.Resources>
            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Static styles:VsResourceKeys.TextBoxStyleKey}}" />
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource {x:Static styles:VsBrushes.WindowTextKey}}" />
            </Style>
            <Style TargetType="TreeView">
                <Setter Property="Background" Value="{DynamicResource {x:Static styles:VsBrushes.WindowKey}}" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static styles:VsBrushes.WindowTextKey}}" />
                <!-- 去掉 WPF 默认浅色边框，避免 Dark 主题下出现亮色描边 -->
                <Setter Property="BorderThickness" Value="0" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部搜索框：输入即搜（UpdateSourceTrigger=PropertyChanged）；空文本时显示水印提示 -->
        <Grid Grid.Row="0" Margin="4,4,4,2">
            <TextBox Padding="6,3"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="11"
                       IsHitTestVisible="False"
                       Opacity="0.5"
                       Text="搜索文件">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SearchText}" Value="">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <!-- 状态行：左侧过滤开关（默认选中，只展示指定目录），右侧状态文字
             （Grid Auto + * 两列 + 右对齐 ≈ flex space-between） -->
        <Grid Grid.Row="1" Margin="8,2,8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- 切换按钮：外观像按钮、点击进入选中态（VS 主题蓝底）、再点取消。
                 圆角需自写模板（ToggleButton 无 CornerRadius 属性），主题色全用动态键 -->
            <ToggleButton Padding="10,5"
                          VerticalAlignment="Center"
                          IsChecked="{Binding ScopeToDesignatedDirectory}">
                <ToggleButton.Style>
                    <Style TargetType="ToggleButton">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Foreground" Value="{DynamicResource {x:Static styles:VsBrushes.WindowTextKey}}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="4"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Bd" Property="Background">
                                                <Setter.Value>
                                                    <SolidColorBrush Color="{DynamicResource {x:Static styles:VsColors.HighlightKey}}" />
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                        <!-- 悬停轻微变暗提示可点击（主题无关的 Opacity 实现） -->
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ToggleButton.Style>
                <StackPanel Orientation="Horizontal">
                    <vs:Image Width="16"
                              Height="16"
                              Margin="0,0,6,0"
                              VerticalAlignment="Center"
                              Source="KnownMonikers.JSONScript" />
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{DynamicResource {x:Static styles:VsBrushes.WindowTextKey}}"
                               Text="翻译源文件目录" />
                </StackPanel>
            </ToggleButton>
            <TextBlock Grid.Column="1"
                       Margin="8,0,0,0"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Opacity="0.6"
                       Text="{Binding StatusText}" />
        </Grid>

        <!-- 目录树：TreeView 自带 ScrollViewer，超出自动滚动；
             每项 = VS 图像目录图标 + 文件名，图标与解决方案资源管理器同一来源 -->
        <TreeView Grid.Row="2"
                  Margin="2,0,4,4"
                  ItemsSource="{Binding Items}">
            <!-- 选中高亮跟随 VS 主题：WPF TreeViewItem 默认模板选中时取 SystemColors.HighlightBrushKey
                 （系统浅色，Dark 下刺眼）。在此作用域内用 VS 主题的 Highlight / HighlightText 覆盖，
                 效果对齐解决方案资源管理器（Dark：主题蓝底 + 亮字） -->
            <TreeView.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                                 Color="{DynamicResource {x:Static styles:VsColors.HighlightKey}}" />
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"
                                 Color="{DynamicResource {x:Static styles:VsColors.HighlightTextKey}}" />
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"
                                 Color="{DynamicResource {x:Static styles:VsColors.HighlightKey}}" />
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}"
                                 Color="{DynamicResource {x:Static styles:VsColors.HighlightTextKey}}" />
            </TreeView.Resources>
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <!-- 点击整行均可触发：文件 → 打开（事件挂元素上，CommandParameter="{Binding}" 即数据项，
                         经代理 ID 回传原实例）；文件夹 → 命令内忽略，保持默认展开行为 -->
                    <StackPanel Margin="0,1"
                                HorizontalAlignment="Stretch"
                                Orientation="Horizontal">
                        <vs:Image Width="16"
                                  Height="16"
                                  Margin="1,0,6,0"
                                  VerticalAlignment="Center"
                                  Source="{Binding IconSource}" />
                        <!-- 前景色直接设在元素上（本地值优先级最高）：RemoteUI 的 TreeViewItem 容器不传递隐式 TextBlock 样式 -->
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{DynamicResource {x:Static styles:VsBrushes.WindowTextKey}}"
                                   Text="{Binding Name}" />
                        <vs:ExtensibilityUICommands.EventHandlers>
                            <vs:EventHandlerCollection>
                                <vs:EventHandler Event="MouseLeftButtonUp"
                                                 Command="{Binding DataContext.OpenItemCommand, ElementName=RootGrid}"
                                                 CommandParameter="{Binding}" />
                            </vs:EventHandlerCollection>
                        </vs:ExtensibilityUICommands.EventHandlers>
                    </StackPanel>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </Grid>
</DataTemplate>
